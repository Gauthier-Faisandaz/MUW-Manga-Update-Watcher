    {
      "parameters": {
        "jsCode": "// Parse the LLM's JSON response, stripping markdown code fences if present\nlet content;\nif (Array.isArray(items[0].json)) {\n  content = items[0].json[0].text;\n} else if (items[0].json.text) {\n  content = items[0].json.text;\n} else {\n  content = JSON.stringify(items[0].json);\n}\n\ncontent = content.replace(/```json\\s*/g, \"\").replace(/```\\s*/g, \"\").trim();\n\ntry {\n  const parsed = JSON.parse(content);\n  return [{ json: parsed }];\n} catch (error) {\n  return [{ json: { error: \"JSON parsing failed\", error_message: error.message, raw_output: content } }];\n}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2384,
        -736
      ],
      "id": "b8317f66-7a49-4969-ae67-e02b8e351859",
