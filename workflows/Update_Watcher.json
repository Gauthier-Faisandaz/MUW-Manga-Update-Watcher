    {
      "parameters": {
        "jsCode": "const dateStr = $('Code in JavaScript').item.json.date || $('If date is invalid (relative, string)').item.json.date_raw;\n\nif (!dateStr) {\n  return { json: { error: 'No date provided' } };\n}\n\nconst [day, month, year] = dateStr.split(/[\\.\\-]/);\n\nif (!day || !month || !year) {\n  return { json: { error: 'Invalid date format, expected DD.MM.YYYY or DD-MM-YYYY' } };\n}\n\nconst date = new Date(`${year}-${month}-${day}`);\n\nif (isNaN(date.getTime())) {\n  return { json: { error: 'Invalid date values' } };\n}\n\nreturn { \n  json: { \n    date_iso: date.toISOString(),\n    date_only: `${year}-${month}-${day}`,\n    original: dateStr\n  } \n};\n"
      },
