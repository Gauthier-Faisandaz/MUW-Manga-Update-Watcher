    {
      "parameters": {
        "jsCode": "// Extract the manga's base URL (strip the chapter segment) from the incoming\n// webhook payload, e.g. sent by a browser extension or Shortcuts automation\n// while reading a chapter.\nfor (const item of $input.all()) {\n  const fullUrl = item.json.body.url;\n\n  const chapterIndex = fullUrl.indexOf('/chapter-');\n  const mangaBaseUrl = fullUrl.substring(0, chapterIndex + 1);\n\n  item.json.body.mangaBaseUrl = mangaBaseUrl;\n\n  console.log('Full URL:', fullUrl);\n  console.log('Manga URL:', mangaBaseUrl);\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ],
      "id": "4114b124-e088-441c-9410-15a47e9e96af",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "YOUR_NOTION_DATABASE_ID",
          "mode": "list",
          "cachedResultName": "Mangas, comics, webtoons"
        },
        "returnAll": true,
        "filterType": "manual",
        "filters": {
