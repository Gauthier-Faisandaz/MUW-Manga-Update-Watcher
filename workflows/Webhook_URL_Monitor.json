      "id": "d8f1c4fc-2674-46c6-b542-f58684e650c8",
      "name": "Update a database page"
    },
    {
      "parameters": {
        "jsCode": "// Same base-URL extraction, used on the manual-add webhook path, with a\n// fallback for URLs that are already on the manga's root page (no chapter\n// segment in the path).\nfor (const item of $input.all()) {\n  const fullUrl = item.json.body.url;\n\n  let mangaBaseUrl;\n  const chapterIndex = fullUrl.indexOf('/chapter-');\n\n  if (chapterIndex !== -1) {\n    mangaBaseUrl = fullUrl.substring(0, chapterIndex + 1);\n  } else {\n    mangaBaseUrl = fullUrl;\n  }\n\n  const queryIndex = mangaBaseUrl.indexOf('?');\n  if (queryIndex !== -1) {\n    mangaBaseUrl = mangaBaseUrl.substring(0, queryIndex);\n  }\n\n  item.json.body.mangaBaseUrl = mangaBaseUrl;\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        224
      ],
      "id": "4c325e58-e050-4046-9bf4-bc496540d97e",
      "name": "Code in JavaScript1"
    },
